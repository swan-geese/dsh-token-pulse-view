{
  "name": "dsh-token-pulse-view",
  "version": "1.0.0",
  "description": "Token Pulse: a premium token-usage dashboard contributed as a DSH Conversation View — per-turn flow chart, cache hit, context gauge, model attribution",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "token-usage",
    "dashboard",
    "statistics",
    "conversation-view"
  ],
  "license": "MIT"
}
